{
  "name": "regalalebitcoins",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @regalale/web build",
    "build:mainnet": "pnpm --filter @regalale/web build:mainnet",
    "e2e:simulado": "pnpm --filter @regalale/e2e simulado",
    "e2e:avanzado": "pnpm --filter @regalale/e2e avanzado"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
